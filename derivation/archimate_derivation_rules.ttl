    rdfs:label "PDR8: Flow + Structural (reverse) → Flow" ;
    rdfs:comment "If flow p(a,b):S and structural q(b,c):T exist, potentially derive r(a,c):S" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
