                                     archimate:derivationRule deriv:PDR8_FlowStructural ;
                                     archimate:description "Derived via PDR8: flow + structural" ;
                                     archimate:derivedFrom <<?a archimate:flow ?b>>, <<?b ?structRel ?c>> .
        }
        WHERE {
            ?a archimate:flow ?b .
            ?b ?structRel ?c .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a archimate:flow ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                archimate:flow archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR9: Structural + Dynamic (reverse) → Dynamic
deriv:PDR9_StructuralDynamicReverse rdf:type sh:SPARQLRule ;
    rdfs:label "PDR9: Structural + Dynamic (reverse) → Dynamic" ;
    rdfs:comment "If structural p(a,b):S and dynamic q(a,c):T exist, potentially derive r(b,c):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?b ?dynRel ?c .
            <<?b ?dynRel ?c>> archimate:confidence archimate:PotentialDerivation ;
                             archimate:derivationRule deriv:PDR9_StructuralDynamicReverse ;
                             archimate:description "Derived via PDR9: structural + dynamic (reverse)" ;
                             archimate:derivedFrom <<?a ?structRel ?b>>, <<?a ?dynRel ?c>> .
        }
        WHERE {
            ?a ?structRel ?b .
            ?a ?dynRel ?c .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            ?dynRel rdfs:subPropertyOf+ archimate:dynamicRelationship .
            
            FILTER(?b != ?c)
            FILTER NOT EXISTS { ?b ?dynRel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?dynRel archimate:permittedBy ?permitsDynRel }
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?b rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?dynRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR10: Flow Chain → Flow
