    """ .

## PDR11: Triggering + Structural (reverse) → Triggering
deriv:PDR11_TriggeringStructuralReverse rdf:type sh:SPARQLRule ;
    rdfs:label "PDR11: Triggering + Structural (reverse) → Triggering" ;
    rdfs:comment "If triggering p(a,b):S and structural q(c,b):T exist, potentially derive r(a,c):S" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a archimate:triggering ?c .
            <<?a archimate:triggering ?c>> archimate:confidence archimate:PotentialDerivation ;
                                           archimate:derivationRule deriv:PDR11_TriggeringStructuralReverse ;
                                           archimate:description "Derived via PDR11: triggering + structural (reverse)" ;
                                           archimate:derivedFrom <<?a archimate:triggering ?b>>, <<?c ?structRel ?b>> .
        }
        WHERE {
            ?a archimate:triggering ?b .
            ?c ?structRel ?b .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a archimate:triggering ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                archimate:triggering archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR12: Grouping Element Derivation
deriv:PDR12_GroupingDerivation rdf:type sh:SPARQLRule ;
    rdfs:label "PDR12: Grouping Element Derivation" ;
    rdfs:comment "If aggregation/composition p(b,a):S and realization/assignment q(b,c):T exist with b being Grouping, potentially derive r(a,c):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a ?targetRel ?c .
            <<?a ?targetRel ?c>> archimate:confidence archimate:PotentialDerivation ;
                                archimate:derivationRule deriv:PDR12_GroupingDerivation ;
                                archimate:description "Derived via PDR12: grouping element derivation" ;
                                archimate:derivedFrom <<?b ?sourceRel ?a>>, <<?b ?targetRel ?c>> .
        }
        WHERE {
            ?b ?sourceRel ?a .
            ?b ?targetRel ?c .
            
            # b must be a Grouping element
            ?b rdf:type/rdfs:subClassOf* archimate:Grouping .
            
            # Source relationship must be aggregation or composition
            {
                ?sourceRel rdfs:subPropertyOf+ archimate:aggregation
            } UNION {
                ?sourceRel rdfs:subPropertyOf+ archimate:composition  
            }
            
            # Target relationship must be realization or assignment
            {
                ?targetRel rdfs:subPropertyOf+ archimate:realization
            } UNION {
                ?targetRel rdfs:subPropertyOf+ archimate:assignment
            }
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a ?targetRel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?sourceRel archimate:permittedBy ?permitsSourceRel }
            FILTER EXISTS { ?targetRel archimate:permittedBy ?permitsTargetRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?targetRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

