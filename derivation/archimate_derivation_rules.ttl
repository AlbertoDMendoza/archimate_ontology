@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix archimate: <https://purl.org/archimate#> .
@prefix deriv: <https://purl.org/archimate/derivation#> .

### ArchiMate Derivation Rules Implementation
<https://purl.org/archimate/derivation> rdf:type owl:Ontology ;
    owl:imports <https://purl.org/archimate/owl> ;
    rdfs:label "ArchiMate Derivation Rules" ;
    rdfs:comment "Complete implementation of ArchiMate derivation rules DR1-DR8 and PDR1-PDR12 using SPARQL CONSTRUCT rules." ;
    dct:creator "Alberto D. Mendoza" ;
    dct:created "2026-02-15"^^xsd:date ;
    dct:modified "2026-08-08"^^xsd:date ;
    dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
    owl:versionInfo "Beta" ;
    sh:declare [
        sh:prefix "archimate" ;
        sh:namespace "https://purl.org/archimate#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    ] , [
        sh:prefix "deriv" ;
        sh:namespace "https://purl.org/archimate/derivation#"^^xsd:anyURI ;
    ] ;
    rdfs:seeAlso <https://digital-portfolio.opengroup.org/archimate-specs/latest/99-appendices/02-relationships-normative.html> .

### Integration with ArchiMate Ontology
# THIS FILE HOLDS sh:SPARQLRule ONLY, AND MUST HOLD NO sh:NodeShape.
#
# Load it into any graph EXCEPT the SHACL shapes graph. The natural home is
# <https://purl.org/archimate/derivation> — the ontology IRI this file declares for itself — together
# with the axioms its rules consult, so the whole derivation layer drops and reloads as a unit.
# Applications read the rule descriptions back with ordinary SPARQL, and that is no argument for the
# default graph: an unqualified query reads the union of all graphs, so a named graph is just as
# visible. The shapes graph is the one place that would hide them.
#
# SHACL reads shapes from the shapes graph alone, so a node shape placed here is inert data: it never
# selects a focus node and never reports a violation. Constraints belong in validation/.
#
# owl:imports note:
# The ontology declares @base <https://purl.org/archimate#> so its IRI is
# <https://purl.org/archimate#>. We import <https://purl.org/archimate/owl>
# which is the PURL that redirects to the raw Turtle file. These URIs differ
# but engines resolve owl:imports by dereferencing the URL, so the import
# works. purl.org does not support content negotiation (Accept headers) —
# separate PURLs are used for each representation (/archimate → SKOS HTML,
# /archimate/owl → OWL Turtle).
#
# Integration with other validation files:
# - archimate_validation_core.ttl: Element-level validation
# - archimate_validation_metamodel.ttl: Relationship metamodel constraints
# - archimate_validation_profiles.ttl: Profile-specific shapes
#
# Derived relationships are marked with confidence levels:
# - "valid": Definitely correct per ArchiMate spec (DR1-DR8)
# - "potential": Possibly correct, needs review (PDR1-PDR12)
#

### Usage Instructions
# To execute these derivation rules:
# 1. Load your base ArchiMate ontology (ontology/archimate.ttl)
# 2. Load derivation/archimate_derivation_axioms.ttl — REQUIRED BY EVERY RULE BELOW. It carries the
#    cased tables (archimate:permits<Relation>, archimate:permitsDirect<Relation>) and the
#    archimate:permittedBy map from a relation to the predicate holding its permissions. Every rule
#    requires the tables to permit its conclusion between the endpoint types; without this file that
#    premise never matches and NOTHING derives, silently. One lookup stands in for Appendix B's
#    fourteen B.4 endpoint clauses, which are subtractive and forbid only pairs the tables already
#    exclude.
# 3. Load derivation/archimate_derivation_strengths.ttl  — REQUIRED. The weakest-link rules below
#    compare archimate:structuralStrength / archimate:dependencyStrength arithmetically; without this
#    file those premises never match and the rules derive nothing, silently.
# 4. Load derivation/archimate_derivation_provenance.ttl — required only if you intend to record
#    archimate:confidence / derivedFrom / derivationRule on what you derive. Load it somewhere ordinary
#    SPARQL can read, since applications read these back.
# 5. Load this derivation rules file
# 6. Run SPARQL CONSTRUCT queries or use SHACL-Advanced Features
# 7. The derived relationships will have metadata indicating:
#    - Confidence level (valid/potential)
#    - Derivation rule used
#    - Source relationships that led to the derivation
#    - Timestamps and provenance

# Example usage in SPARQL:
# # Execute all valid derivation rules
# CONSTRUCT WHERE {
#     ?rule rdf:type sh:SPARQLRule .
#     ?rule sh:construct ?constructQuery .
#     # Execute the construct query
# }
#
# # Query derived relationships  
# SELECT ?source ?rel ?target ?confidence ?rule WHERE {
#     ?source ?rel ?target .
#     <<?source ?rel ?target>> archimate:confidence ?confidence ;
#                              archimate:description ?desc .
#     BIND(STRAFTER(STR(?desc), "Derived via ") AS ?rule)
#     FILTER(?confidence IN ("valid", "potential"))
# }


### Helper Properties for Relationship Strength
# archimate:structuralStrength / archimate:dependencyStrength are declared and assigned in
# derivation/archimate_derivation_strengths.ttl. LOAD THAT FILE ALONGSIDE THIS ONE: the rules below
# compare the strength values arithmetically, and without them every weakest-link rule silently derives
# nothing — the premises simply fail to match, with no error.
#
# They were in ontology/archimate.ttl §3.5 until 2026-07-29, on the reasoning that this file goes into a
# SHACL shapes graph hidden from ordinary SPARQL. That is a deployment choice, not a property of the
# file, and the ordering is not part of the ArchiMate language, so it moved to sit with the rules that
# need it.

### Valid Derivation Rules (DR1-DR8)

## DR1: Transitivity of Specialization (Appendix B, B.2.1)
## No sh:construct body: archimate:specialization is declared owl:TransitiveProperty in
## ontology/archimate.ttl, so any OWL-aware consumer derives this already -- an unexecuted
## CONSTRUCT here would be a decorative rule that looks live and is not.
deriv:DR1_SpecializationTransitivity rdf:type sh:SPARQLRule ;
    rdfs:label "DR1: Transitivity of Specialization" ;
    rdfs:comment "If two relationships p(a,b):S and q(b,c):S exist, with S being Specialization, then a relationship r(a,c):S can be derived." .

## DR2: Derivation Between Structural Relationships
deriv:DR2_StructuralChain rdf:type sh:SPARQLRule ;
    rdfs:label "DR2: Structural Relationship Chain Derivation" ;
    rdfs:comment "If two structural relationships p(a,b):S and q(b,c):T exist, derive r(a,c):U with U being the weakest of S and T." ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a ?weakerRel ?c .
            <<?a ?weakerRel ?c>> archimate:confidence archimate:ValidDerivation ;
                                archimate:derivationRule deriv:DR2_StructuralChain ;
                                archimate:description "Derived via DR2: structural relationship chain" ;
                                archimate:derivedFrom <<?a ?rel1 ?b>>, <<?b ?rel2 ?c>> .
        }
        WHERE {
            # Find chain of two structural relationships
            ?a ?rel1 ?b .
            ?b ?rel2 ?c .
            
            # Both must be structural relationships
            ?rel1 rdfs:subPropertyOf+ archimate:structuralRelationship .
            ?rel2 rdfs:subPropertyOf+ archimate:structuralRelationship .
            
            # Get strength values
            ?rel1 archimate:structuralStrength ?strength1 .
            ?rel2 archimate:structuralStrength ?strength2 .
            
            # Determine weaker relationship
            BIND(IF(?strength1 <= ?strength2, ?rel1, ?rel2) AS ?weakerRel)
            
            # Avoid self-relationships and direct relationships
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a ?weakerRel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?rel1 archimate:permittedBy ?permitsRel1 }
            FILTER EXISTS { ?rel2 archimate:permittedBy ?permitsRel2 }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?weakerRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## DR3: Derivation Between Structural and Dependency Relationships
deriv:DR3_StructuralDependency rdf:type sh:SPARQLRule ;
    rdfs:label "DR3: Structural + Dependency → Dependency" ;
    rdfs:comment "If structural p(a,b):S and dependency q(b,c):T exist, derive r(a,c):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a ?depRel ?c .
            <<?a ?depRel ?c>> archimate:confidence archimate:ValidDerivation ;
                             archimate:derivationRule deriv:DR3_StructuralDependency ;
                             archimate:description "Derived via DR3: structural + dependency" ;
                             archimate:derivedFrom <<?a ?structRel ?b>>, <<?b ?depRel ?c>> .
        }
        WHERE {
            ?a ?structRel ?b .
            ?b ?depRel ?c .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            ?depRel rdfs:subPropertyOf+ archimate:dependencyRelationship .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a ?depRel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?depRel archimate:permittedBy ?permitsDepRel }
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?depRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## DR4: Derivation Between Opposing Structural and Dependency Relationships  
deriv:DR4_OpposingStructuralDependency rdf:type sh:SPARQLRule ;
    rdfs:label "DR4: Opposing Structural + Dependency → Dependency" ;
    rdfs:comment "If structural p(a,b):S and dependency q(c,b):T exist, derive r(c,a):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?c ?depRel ?a .
            <<?c ?depRel ?a>> archimate:confidence archimate:ValidDerivation ;
                             archimate:derivationRule deriv:DR4_OpposingStructuralDependency ;
                             archimate:description "Derived via DR4: opposing structural + dependency" ;
                             archimate:derivedFrom <<?a ?structRel ?b>>, <<?c ?depRel ?b>> .
        }
        WHERE {
            ?a ?structRel ?b .
            ?c ?depRel ?b .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            ?depRel rdfs:subPropertyOf+ archimate:dependencyRelationship .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?c ?depRel ?a }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?depRel archimate:permittedBy ?permitsDepRel }
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?c rdf:type ?permSourceType .
                ?a rdf:type ?permTargetType .
                ?depRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## DR5: Derivation Between Structural and Dynamic Relationships
deriv:DR5_StructuralDynamic rdf:type sh:SPARQLRule ;
    rdfs:label "DR5: Structural + Dynamic → Dynamic" ;
    rdfs:comment "If structural p(a,b):S and dynamic q(b,c):T exist, derive r(a,c):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a ?dynRel ?c .
            <<?a ?dynRel ?c>> archimate:confidence archimate:ValidDerivation ;
                             archimate:derivationRule deriv:DR5_StructuralDynamic ;
                             archimate:description "Derived via DR5: structural + dynamic" ;
                             archimate:derivedFrom <<?a ?structRel ?b>>, <<?b ?dynRel ?c>> .
        }
        WHERE {
            ?a ?structRel ?b .
            ?b ?dynRel ?c .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            ?dynRel rdfs:subPropertyOf+ archimate:dynamicRelationship .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a ?dynRel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?dynRel archimate:permittedBy ?permitsDynRel }
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?dynRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## DR6: Derivation Between Structural and Flow Relationships
deriv:DR6_StructuralFlow rdf:type sh:SPARQLRule ;
    rdfs:label "DR6: Structural + Flow (opposite) → Flow" ;
    rdfs:comment "If structural p(a,b):S and flow q(c,b):T exist, derive r(c,a):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?c archimate:flow ?a .
            <<?c archimate:flow ?a>> archimate:confidence archimate:ValidDerivation ;
                                     archimate:derivationRule deriv:DR6_StructuralFlow ;
                                     archimate:description "Derived via DR6: structural + flow (opposite)" ;
                                     archimate:derivedFrom <<?a ?structRel ?b>>, <<?c archimate:flow ?b>> .
        }
        WHERE {
            ?a ?structRel ?b .
            ?c archimate:flow ?b .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?c archimate:flow ?a }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?c rdf:type ?permSourceType .
                ?a rdf:type ?permTargetType .
                archimate:flow archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## DR7: Derivation Between Triggering and Structural Relationships
deriv:DR7_TriggeringStructural rdf:type sh:SPARQLRule ;
    rdfs:label "DR7: Triggering + Structural → Triggering" ;
    rdfs:comment "If triggering p(a,b):S and structural q(b,c):T exist, derive r(a,c):S" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a archimate:triggering ?c .
            <<?a archimate:triggering ?c>> archimate:confidence archimate:ValidDerivation ;
                                           archimate:derivationRule deriv:DR7_TriggeringStructural ;
                                           archimate:description "Derived via DR7: triggering + structural" ;
                                           archimate:derivedFrom <<?a archimate:triggering ?b>>, <<?b ?structRel ?c>> .
        }
        WHERE {
            ?a archimate:triggering ?b .
            ?b ?structRel ?c .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a archimate:triggering ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                archimate:triggering archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## DR8: Derivation Between Triggering Relationships (Transitivity)
deriv:DR8_TriggeringTransitivity rdf:type sh:SPARQLRule ;
    rdfs:label "DR8: Triggering Transitivity" ;
    rdfs:comment "If triggering p(a,b):S and triggering q(b,c):S exist, derive r(a,c):S" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a archimate:triggering ?c .
            <<?a archimate:triggering ?c>> archimate:confidence archimate:ValidDerivation ;
                                           archimate:derivationRule deriv:DR8_TriggeringTransitivity ;
                                           archimate:description "Derived via DR8: triggering transitivity" ;
                                           archimate:derivedFrom <<?a archimate:triggering ?b>>, <<?b archimate:triggering ?c>> .
        }
        WHERE {
            ?a archimate:triggering ?b .
            ?b archimate:triggering ?c .
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a archimate:triggering ?c }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                archimate:triggering archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

### Junction Transparency
# Not one of DR1-DR8: a Junction is a connector, not an element, so it has no row in Appendix B's
# tables and cannot -- it merges or splits relationships OF ONE TYPE, decided per diagram, not per
# concept pair (see derivation/README.md's "Junction is a connector, not a concept pair"). Without this
# rule, a chain through a junction (A -> Junction -> B) silently derives nothing: nothing in DR1-DR8
# treats a junction endpoint as transparent, so a modeller who routes a relationship through one gets
# no derived direct edge between the real endpoints.
#
# HOMOGENEITY IS STRUCTURAL: the same variable ?r is required on both hops, so both legs must already
# be the same relationship. A junction cannot mix relationship types by construction of this rule --
# <#JunctionRelationshipHomogeneity> (archimate_validation_metamodel.ttl) still matters, because it
# catches a modeller *asserting* mixed types through a junction, which this rule cannot: the rule
# simply declines to fire rather than flagging the error.
deriv:JunctionTransparency rdf:type sh:SPARQLRule ;
    rdfs:label "Junction Transparency" ;
    rdfs:comment "If p(a,j):R and p(j,c):R exist with j a Junction, derive p(a,c):R -- a junction is transparent to the relationship passing through it." ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a ?r ?c .
            <<?a ?r ?c>> archimate:confidence archimate:ValidDerivation ;
                        archimate:derivationRule deriv:JunctionTransparency ;
                        archimate:description "Derived via Junction transparency: connector merge/split" ;
                        archimate:derivedFrom <<?a ?r ?j>>, <<?j ?r ?c>> .
        }
        WHERE {
            ?a ?r ?j .
            ?j a archimate:Junction .
            ?j ?r ?c .

            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a ?r ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?r archimate:permittedBy ?permitsR }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl. A Junction endpoint is exempt:
            # connectors have no row in the tables, and an intermediate hop of a
            # multi-junction chain is one. The chain's final conclusion is still judged.
            FILTER (
                EXISTS { ?a a archimate:Junction }
                || EXISTS { ?c a archimate:Junction }
                || EXISTS {
                    ?a rdf:type ?permSourceType .
                    ?c rdf:type ?permTargetType .
                    ?r archimate:permittedBy ?permits .
                    ?permSourceType ?permits ?permTargetType .
                }
            )
        }
    """ .

### Potential Derivation Rules (PDR1-PDR12)

## PDR1: Specialization + Other Relationship → Potentially Same Relationship
deriv:PDR1_SpecializationInheritance rdf:type sh:SPARQLRule ;
    rdfs:label "PDR1: Specialization Inheritance (Forward)" ;
    rdfs:comment "If specialization p(a,b):S and relationship q(b,c):T exist, potentially derive r(a,c):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a ?rel ?c .
            <<?a ?rel ?c>> archimate:confidence archimate:PotentialDerivation ;
                          archimate:derivationRule deriv:PDR1_SpecializationInheritance ;
                          archimate:description "Derived via PDR1: specialization inheritance (forward)" ;
                          archimate:derivedFrom <<?a archimate:specialization ?b>>, <<?b ?rel ?c>> .
        }
        WHERE {
            ?a archimate:specialization ?b .
            ?b ?rel ?c .
            
            # Only for structural, dependency, or dynamic relationships
            {
                ?rel rdfs:subPropertyOf+ archimate:structuralRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dependencyRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dynamicRelationship 
            }
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a ?rel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?rel archimate:permittedBy ?permitsRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?rel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR2: Specialization + Other Relationship → Potentially Same Relationship (Reverse)
deriv:PDR2_SpecializationInheritanceReverse rdf:type sh:SPARQLRule ;
    rdfs:label "PDR2: Specialization Inheritance (Reverse)" ;
    rdfs:comment "If specialization p(a,b):S and relationship q(c,b):T exist, potentially derive r(c,a):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?c ?rel ?a .
            <<?c ?rel ?a>> archimate:confidence archimate:PotentialDerivation ;
                          archimate:derivationRule deriv:PDR2_SpecializationInheritanceReverse ;
                          archimate:description "Derived via PDR2: specialization inheritance (reverse)" ;
                          archimate:derivedFrom <<?a archimate:specialization ?b>>, <<?c ?rel ?b>> .
        }
        WHERE {
            ?a archimate:specialization ?b .
            ?c ?rel ?b .
            
            # Only for structural, dependency, or dynamic relationships
            {
                ?rel rdfs:subPropertyOf+ archimate:structuralRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dependencyRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dynamicRelationship 
            }
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?c ?rel ?a }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?rel archimate:permittedBy ?permitsRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?c rdf:type ?permSourceType .
                ?a rdf:type ?permTargetType .
                ?rel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR3: Specialization Source Inheritance
deriv:PDR3_SpecializationSourceInheritance rdf:type sh:SPARQLRule ;
    rdfs:label "PDR3: Specialization Source Inheritance" ;
    rdfs:comment "If specialization p(a,b):S and relationship q(a,c):T exist, potentially derive r(b,c):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?b ?rel ?c .
            <<?b ?rel ?c>> archimate:confidence archimate:PotentialDerivation ;
                          archimate:derivationRule deriv:PDR3_SpecializationSourceInheritance ;
                          archimate:description "Derived via PDR3: specialization source inheritance" ;
                          archimate:derivedFrom <<?a archimate:specialization ?b>>, <<?a ?rel ?c>> .
        }
        WHERE {
            ?a archimate:specialization ?b .
            ?a ?rel ?c .
            
            # Only for structural, dependency, or dynamic relationships
            {
                ?rel rdfs:subPropertyOf+ archimate:structuralRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dependencyRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dynamicRelationship 
            }
            
            FILTER(?b != ?c)
            FILTER NOT EXISTS { ?b ?rel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?rel archimate:permittedBy ?permitsRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?b rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?rel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR4: Specialization Target Inheritance
