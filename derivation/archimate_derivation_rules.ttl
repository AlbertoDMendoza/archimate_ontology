        CONSTRUCT {
            ?b ?depRel ?c .
            <<?b ?depRel ?c>> archimate:confidence archimate:PotentialDerivation ;
                             archimate:derivationRule deriv:PDR6_StructuralDependencyFromSource ;
                             archimate:description "Derived via PDR6: structural + dependency (from source)" ;
                             archimate:derivedFrom <<?a ?structRel ?b>>, <<?a ?depRel ?c>> .
        }
        WHERE {
            ?a ?structRel ?b .
            ?a ?depRel ?c .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            ?depRel rdfs:subPropertyOf+ archimate:dependencyRelationship .
            
            FILTER(?b != ?c)
            FILTER NOT EXISTS { ?b ?depRel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?depRel archimate:permittedBy ?permitsDepRel }
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?b rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?depRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR7: Dependency Chain → Weakest Dependency
deriv:PDR7_DependencyChain rdf:type sh:SPARQLRule ;
    rdfs:label "PDR7: Dependency Chain → Weakest" ;
    rdfs:comment "If dependencies p(a,b):S and q(b,c):T exist, potentially derive r(a,c):U with U being weakest" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?a ?weakerRel ?c .
            <<?a ?weakerRel ?c>> archimate:confidence archimate:PotentialDerivation ;
                                archimate:derivationRule deriv:PDR7_DependencyChain ;
                                archimate:description "Derived via PDR7: dependency chain" ;
                                archimate:derivedFrom <<?a ?rel1 ?b>>, <<?b ?rel2 ?c>> .
        }
        WHERE {
            ?a ?rel1 ?b .
            ?b ?rel2 ?c .
            
            ?rel1 rdfs:subPropertyOf+ archimate:dependencyRelationship .
            ?rel2 rdfs:subPropertyOf+ archimate:dependencyRelationship .
            
            # Get strength values
            ?rel1 archimate:dependencyStrength ?strength1 .
            ?rel2 archimate:dependencyStrength ?strength2 .
            
            # Determine weaker relationship
            BIND(IF(?strength1 <= ?strength2, ?rel1, ?rel2) AS ?weakerRel)
            
            FILTER(?a != ?c)
            FILTER NOT EXISTS { ?a ?weakerRel ?c }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?rel1 archimate:permittedBy ?permitsRel1 }
            FILTER EXISTS { ?rel2 archimate:permittedBy ?permitsRel2 }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?a rdf:type ?permSourceType .
                ?c rdf:type ?permTargetType .
                ?weakerRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR8: Flow + Structural (reverse) → Flow
