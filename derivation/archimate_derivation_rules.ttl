                          archimate:derivationRule deriv:PDR4_SpecializationTargetInheritance ;
                          archimate:description "Derived via PDR4: specialization target inheritance" ;
                          archimate:derivedFrom <<?a archimate:specialization ?b>>, <<?c ?rel ?a>> .
        }
        WHERE {
            ?a archimate:specialization ?b .
            ?c ?rel ?a .
            
            # Only for structural, dependency, or dynamic relationships
            {
                ?rel rdfs:subPropertyOf+ archimate:structuralRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dependencyRelationship 
            } UNION {
                ?rel rdfs:subPropertyOf+ archimate:dynamicRelationship 
            }
            
            FILTER(?c != ?b)
            FILTER NOT EXISTS { ?c ?rel ?b }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?rel archimate:permittedBy ?permitsRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?c rdf:type ?permSourceType .
                ?b rdf:type ?permTargetType .
                ?rel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR5: Structural + Dependency (at source) → Dependency
deriv:PDR5_StructuralDependencyAtSource rdf:type sh:SPARQLRule ;
    rdfs:label "PDR5: Structural + Dependency (at source) → Dependency" ;
    rdfs:comment "If structural p(a,b):S and dependency q(c,a):T exist, potentially derive r(c,b):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
    sh:construct """
        CONSTRUCT {
            ?c ?depRel ?b .
            <<?c ?depRel ?b>> archimate:confidence archimate:PotentialDerivation ;
                             archimate:derivationRule deriv:PDR5_StructuralDependencyAtSource ;
                             archimate:description "Derived via PDR5: structural + dependency (at source)" ;
                             archimate:derivedFrom <<?a ?structRel ?b>>, <<?c ?depRel ?a>> .
        }
        WHERE {
            ?a ?structRel ?b .
            ?c ?depRel ?a .
            
            ?structRel rdfs:subPropertyOf+ archimate:structuralRelationship .
            ?depRel rdfs:subPropertyOf+ archimate:dependencyRelationship .
            
            FILTER(?c != ?b)
            FILTER NOT EXISTS { ?c ?depRel ?b }

            # Cite only concrete relationships. rdfs:subPropertyOf is reflexive under
            # RDFS entailment, so an abstract superproperty binds here too and would be
            # recorded as a source edge nobody drew. Only the eleven concrete relations
            # carry archimate:permittedBy.
            FILTER EXISTS { ?depRel archimate:permittedBy ?permitsDepRel }
            FILTER EXISTS { ?structRel archimate:permittedBy ?permitsStructRel }

            # Appendix B permits this relationship between these endpoint types.
            # Requires archimate_derivation_axioms.ttl.
            FILTER EXISTS {
                ?c rdf:type ?permSourceType .
                ?b rdf:type ?permTargetType .
                ?depRel archimate:permittedBy ?permits .
                ?permSourceType ?permits ?permTargetType .
            }
        }
    """ .

## PDR6: Structural + Dependency (from source) → Dependency  
deriv:PDR6_StructuralDependencyFromSource rdf:type sh:SPARQLRule ;
    rdfs:label "PDR6: Structural + Dependency (from source) → Dependency" ;
    rdfs:comment "If structural p(a,b):S and dependency q(a,c):T exist, potentially derive r(b,c):T" ;
    sh:prefixes <https://purl.org/archimate/derivation> ;
