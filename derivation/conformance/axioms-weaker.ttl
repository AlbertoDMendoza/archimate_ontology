@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

archi:weakerOrEqual a owl:ObjectProperty ;
    rdfs:label "weaker or equal to" ;
    rdfs:comment "Subject relation is weaker than or equal to the object relation. Transitive closure is materialized here so a ruleset need not rely on the engine expanding it." .

# Relationship categories, so a single rule can dispatch on category.
