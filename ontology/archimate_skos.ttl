archimate-skos:BusinessProcess skos:related <http://www.w3.org/ns/org#Role> ;
    skos:closeMatch <http://purl.org/goodrelations/v1#BusinessFunction> .

archimate-skos:ApplicationComponent skos:related <http://www.w3.org/ns/dcat#DataService> .

archimate-skos:TechnologyService skos:related <http://www.w3.org/ns/dcat#DataService> .

### Collections for Easier Navigation

archimate-skos:CoreElements rdf:type skos:Collection ;
    rdfs:isDefinedBy <https://purl.org/archimate/skos> ;
    skos:prefLabel "Core ArchiMate Elements"@en ;
    skos:definition "The most commonly used ArchiMate elements across all layers."@en ;
    skos:member archimate-skos:BusinessActor, archimate-skos:BusinessProcess, archimate-skos:BusinessService, archimate-skos:BusinessObject,
                archimate-skos:ApplicationComponent, archimate-skos:ApplicationService, archimate-skos:DataObject,
                archimate-skos:Node, archimate-skos:TechnologyService, archimate-skos:Artifact .

archimate-skos:StructuralElements rdf:type skos:Collection ;
    rdfs:isDefinedBy <https://purl.org/archimate/skos> ;
    skos:prefLabel "Structural Elements"@en ;
    skos:definition "ArchiMate elements that represent structure across all layers."@en ;
    skos:member archimate-skos:BusinessActor, archimate-skos:BusinessRole, archimate-skos:ApplicationComponent, archimate-skos:Node, archimate-skos:Equipment .

archimate-skos:BehaviorElements rdf:type skos:Collection ;
    rdfs:isDefinedBy <https://purl.org/archimate/skos> ;
    skos:prefLabel "Behavior Elements"@en ;
    skos:definition "ArchiMate elements that represent behavior across all layers."@en ;
    skos:member archimate-skos:BusinessProcess, archimate-skos:BusinessFunction, archimate-skos:BusinessService,
                archimate-skos:ApplicationFunction, archimate-skos:ApplicationProcess, archimate-skos:ApplicationService,
                archimate-skos:TechnologyFunction, archimate-skos:TechnologyProcess, archimate-skos:TechnologyService .

archimate-skos:InformationElements rdf:type skos:Collection ;
    rdfs:isDefinedBy <https://purl.org/archimate/skos> ;
    skos:prefLabel "Information Elements"@en ;
    skos:definition "ArchiMate elements that represent information and data."@en ;
    skos:member archimate-skos:BusinessObject, archimate-skos:Representation, archimate-skos:DataObject, archimate-skos:Artifact .