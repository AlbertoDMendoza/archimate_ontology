@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix archimate: <https://purl.org/archimate#> .
@prefix avcore: <https://purl.org/archimate/validation#> .

### SHACL Validation for ArchiMate Basic Constraints
<https://purl.org/archimate/validation> rdf:type owl:Ontology ;
    owl:imports <https://purl.org/archimate/owl> ;
    rdfs:label "ArchiMate Basic Validation Rules" ;
    rdfs:comment "Level 1 Core Validation: universal model quality and graph integrity constraints. Validates concept requirements (identifier, name, documentation), specialization relationship integrity (permitted element-type pairs, no self-loops, no cycles, chain depth), and structural relationship integrity (no circular/self composition/aggregation, composition part uniqueness). For metamodel pattern rules, see archimate_validation_metamodel.ttl. For per-element-type relationship combinations, see archimate_validation_<layer>.ttl." ;
    dct:creator "Alberto D. Mendoza" ;
    dct:created "2026-02-10"^^xsd:date ;
    dct:modified "2026-08-09"^^xsd:date ;
    dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
    owl:versionInfo "Beta" ;
    sh:declare [
        sh:prefix "archimate" ;
        sh:namespace "https://purl.org/archimate#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    ] , [
        sh:prefix "owl" ;
        sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ;
    ] .

### NOTES
# Level 1 Core Validation — Universal model quality and graph integrity.
#
# This file focuses on:
# - Universal concept requirements (identifier, name, documentation)
# - Concept uniqueness constraints
# - Specialization relationship validation (permitted type pairs, no self-loops, no cycles, depth)
# - Relationship structural integrity (no circular/self composition/aggregation,
#   composition part uniqueness)
#
# Organization:
# - Section 1: Universal Concept Requirements
# - Section 2: Specialization Relationship Validation (permitted pairs, self-loops, cycles, depth)
# - Section 3: Structural Relationship Validation (composition, aggregation)
#
# Severity levels:
# - sh:Violation (default): every shape in this file. Most declare no sh:severity and get this by
#   SHACL's own default. Some engines — RDF4J 4.3.x among them — treat every severity as
#   transaction-blocking, so this file has no sh:Info/sh:Warning shapes: an advisory-severity shape
#   left active on such an engine rejects writes rather than annotating them.
#
# ---------------------------------------------------------------------------
# ENGINE REQUIREMENT: sh:targetClass ON ABSTRACT CLASSES
#
# Five shapes in this file target archimate:Concept or archimate:Element. Both are marked
# <#abstract> true in the ontology: they are organizing constructs, and NO NODE IN A REAL MODEL CARRIES
# rdf:type archimate:Concept. A model element is typed archimate:BusinessActor, and reaching Concept
# from there means traversing rdfs:subClassOf.
#
# This is correct as written. SHACL defines the targets of sh:targetClass as the "SHACL instances" of
# the class, and §2.1.3.1 defines a SHACL instance via rdf:type/rdfs:subClassOf* — subclasses
# included, transitively. A conforming engine resolves archimate:BusinessActor to archimate:Concept
# by itself, provided it can see the subclass axioms.
#
# THAT PROVISO IS THE TRAP, and it fails quietly. An engine that evaluates shapes against a dedicated
# shapes graph — RDF4J's ShaclSail, GraphDB — resolves the class hierarchy from THAT graph. Load these
# shapes into the shapes graph while the ontology sits in the default graph, and archimate:Concept has
# no subclasses as far as the validator is concerned. Every one of the five shapes then selects zero
# focus nodes, validation passes, and NOTHING REPORTS THAT ANYTHING WAS SKIPPED. A circular
# composition is accepted in silence.
#
# Two ways to avoid it:
#   * load archimate.ttl into the shapes graph alongside these shapes;
#   * or enable subclass reasoning for shape targeting (RDF4J: ShaclSail's rdfsSubClassReasoning), and
#     make sure the ontology's rdfs:subClassOf statements are visible where that reasoning reads them.
#
# To check rather than assume, count what a target actually selects before trusting a clean report:
#   SELECT (COUNT(*) AS ?n) WHERE { ?x a/rdfs:subClassOf* archimate:Concept }
# A result of 0 against a non-empty model means these shapes are inert.
#
# Deployments that cannot arrange either option can retarget by predicate instead — e.g.
# sh:targetObjectsOf archimate:composition for the composition shapes, or
# sh:targetSubjectsOf archimate:identifier for <#UniqueConceptIdentifier>. That needs no reasoning at
# all and cannot silently select nothing, at the cost of no longer being driven by the class hierarchy.
# The four specialization shapes are already targeted this way, for that reason.
# ---------------------------------------------------------------------------
#
# owl:imports note:
# The ontology declares @base <https://purl.org/archimate#> so its IRI is
# <https://purl.org/archimate#>. We import <https://purl.org/archimate/owl>
# which is the PURL that redirects to the raw Turtle file. These URIs differ
# but engines resolve owl:imports by dereferencing the URL, so the import
# works. purl.org does not support content negotiation (Accept headers) —
# separate PURLs are used for each representation (/archimate → SKOS HTML,
# /archimate/owl → OWL Turtle).
#
# To execute validation:
# 1. Load base ArchiMate ontology (archimate.ttl)
# 2. Load archimate_validation_core.ttl (Level 1) <--<this file>
# 3. Load archimate_validation_metamodel.ttl (Level 2: abstract metamodel pattern rules)
# 4. Load archimate_validation_relationships.ttl (Level 3, optional)
# 5. Load your model data
# 6. Run SHACL validation

### 1. Universal Concepts Requirements

# All realized elements and relationships must have required attributes
avcore:RealizedConceptShape rdf:type sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    rdfs:label "Realized Concept Requirements" ;
    rdfs:comment "Enforces that every realized ArchiMate concept (owl:NamedIndividual instance) has exactly one identifier, at least one name, and any number of documentation values -- name/documentation may repeat as rdf:langString with distinct xml:lang tags for multi-language exchange models, but at most one per language. Targets owl:NamedIndividual to exclude ontology class definitions, which are instances of archimate:Concept via class punning but are not realized model elements." ;
    sh:or (
        [ sh:not [ sh:class archimate:Concept ] ]
        [
            sh:and (
                [ sh:property [
                    sh:path archimate:identifier ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:datatype xsd:string ;
                    sh:pattern "^[a-zA-Z_][a-zA-Z0-9_-]*$" ;
                    sh:message "All realized concepts must have exactly one valid identifier"
                ] ]
                [ sh:property [
                    sh:path archimate:name ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
                    sh:uniqueLang true ;
                    sh:message "All realized concepts must have at least one name (plain xsd:string, or one rdf:langString per xml:lang for multi-language exchange models)"
                ] ]
                [ sh:property [
                    sh:path archimate:documentation ;
                    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
                    sh:uniqueLang true ;
                    sh:message "documentation values must be plain xsd:string, or one rdf:langString per xml:lang for multi-language exchange models"
                ] ]
            )
        ]
    ) .

# Unique identifier constraint across all concepts
avcore:UniqueConceptIdentifier rdf:type sh:NodeShape ;
    sh:targetClass archimate:Concept ;
    rdfs:label "Unique Concept Identifier Constraint" ;
    rdfs:comment "Ensures each concept identifier is unique across the model." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Concept identifiers must be unique across the model" ;
        sh:select """
            SELECT $this WHERE {
                $this archimate:identifier ?id .
                ?other archimate:identifier ?id .
                FILTER(?other != $this)
            }
        """
    ] .

### 2. Specialization Relationship Validation
# Specialization is purely a relationship (spec Section 5.4), not a concept property.
# It connects two elements/concepts of the same type (e.g., specialized process → generic process).

# Specialization must connect a pair of element types Appendix B permits
#
# Most permitted pairs are same-type, but not all: the tables also permit Grouping with any element,
# Contract with BusinessObject, and Constraint with Requirement. Testing the matrix rather than type
# equality keeps this shape in step with relationships.xml.
#
# Reads the permitted matrix from derivation/archimate_derivation_axioms.ttl, which must be in the
# DEFAULT graph — the shapes graph is hidden from ordinary SPARQL. Where that file is not loaded, or
# where an endpoint carries only types the matrix does not cover — profile specializations, for
# instance — the shape stands aside rather than reporting every specialization.
avcore:SpecializationPermitted rdf:type sh:NodeShape ;
    sh:targetSubjectsOf archimate:specialization ;
    rdfs:label "Specialization Permitted Constraint" ;
    rdfs:comment "Ensures specialization relationships connect a pair of element types the ArchiMate 3.2 Appendix B tables permit. Requires derivation/archimate_derivation_axioms.ttl; inactive on endpoints the matrix does not cover." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Specialization is not permitted between these element types (ArchiMate 3.2 Appendix B)" ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this archimate:specialization ?target .

                # Judge only endpoints the permitted matrix covers
                $this rdf:type ?sourceType .
                ?sourceType archimate:permitsSpecialization ?anyTarget .
                ?target rdf:type ?targetType .
                ?anySource archimate:permitsSpecialization ?targetType .

                # Some pair of their types must be permitted
                FILTER NOT EXISTS {
                    $this rdf:type ?st .
                    ?target rdf:type ?tt .
                    ?st archimate:permitsSpecialization ?tt .
                }
            }
        """
    ] .

# No self-specialization
#
# Targeted by predicate, not by class: an inert specialization shape accepts a malformed hierarchy in
# silence. See the ENGINE REQUIREMENT note above.
avcore:NoSelfSpecialization rdf:type sh:NodeShape ;
    sh:targetSubjectsOf archimate:specialization ;
    rdfs:label "No Self-Specialization" ;
    rdfs:comment "Prevents an element from specializing itself." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "An element cannot specialize itself" ;
        sh:select """
            SELECT $this WHERE {
                $this archimate:specialization $this
            }
        """
    ] .

# No circular specialization
#
# archimate:specialization is owl:TransitiveProperty, so a reasoner turns a cycle into a self-loop and
# NoSelfSpecialization reports it as a self-specialization the model does not contain. This shape
# tests the path directly and so reports the actual defect, under any ruleset.
avcore:NoCircularSpecialization rdf:type sh:NodeShape ;
    sh:targetSubjectsOf archimate:specialization ;
    rdfs:label "No Circular Specialization" ;
    rdfs:comment "Prevents circular specialization chains (A specializes B, B specializes C, C specializes A)." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Circular specialization relationships are not allowed (A specializes B, B specializes C, C specializes A)" ;
        sh:select """
            SELECT $this WHERE {
                $this archimate:specialization+ $this
            }
        """
    ] .

# Specialization chain depth
#
# archimate:specialization+ yields the same ancestor set whether or not DR1's closure is materialized,
# so the count is stable across rulesets. A chain of n produces (n-1)(n-2)/2 derived specializations.
avcore:SpecializationChainDepth rdf:type sh:NodeShape ;
    sh:targetSubjectsOf archimate:specialization ;
    rdfs:label "Specialization Chain Depth" ;
    rdfs:comment "Limits an element's specialization ancestry to fewer than 5 levels; deeper chains multiply the derived closure without adding meaning." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Element has 5 or more specialization ancestors; chains this deep multiply the derived closure without adding meaning" ;
        sh:select """
            SELECT $this (COUNT(DISTINCT ?ancestor) AS ?depth) WHERE {
                $this archimate:specialization+ ?ancestor .
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?ancestor) >= 5)
        """
    ] .

### 3. Structural Relationship Validation

## 3.1 Composition Relationships

# No self-composition
avcore:NoSelfComposition rdf:type sh:NodeShape ;
    sh:targetClass archimate:Element ;
    rdfs:label "No Self-Composition" ;
    rdfs:comment "Prevents an element from composing itself." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Elements cannot compose themselves" ;
        sh:select """
            SELECT $this WHERE {
                $this archimate:composition $this
            }
        """
    ] .

# No circular composition
avcore:NoCircularComposition rdf:type sh:NodeShape ;
    sh:targetClass archimate:Element ;
    rdfs:label "No Circular Composition" ;
    rdfs:comment "Prevents circular composition chains (A composes B, B composes C, C composes A)." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Circular composition relationships are not allowed (A composes B, B composes C, C composes A)" ;
        sh:select """
            SELECT $this WHERE {
                $this archimate:composition+ $this
            }
        """
    ] .

# Composition part uniqueness: a part can only belong to one whole
#
# CAVEAT — THE MOST EXPENSIVE ACTIVE SHAPE IN THIS FILE, and the one most likely to need deactivating
# in a transactional deployment. For each part it self-joins the composers (?w1, ?w2 over the same
# predicate — a cross product in the number of wholes) and then evaluates two FILTER NOT EXISTS blocks,
# each over an unbounded `archimate:composition+` closure, per surviving pair.
#
# The exemption those two filters implement is not optional, and it is worth understanding before
# simplifying this shape. If composition is TRANSITIVELY MATERIALIZED — because a derivation engine ran
# DR2, or because the model asserts shortcuts — then every nested element is composed by every one of
# its ancestors, and a naive "exactly one whole" test fails on every deep model. The ancestor exemption
# is what keeps the shape meaningful in that setting: the composers of a part form a chain, so pairwise
# one is always an ancestor of the other, and only a genuine ownership conflict survives.
#
# Consequence for deployment: run this over ASSERTED composition. Over a derived closure it is either
# expensive-and-vacuous (with the exemption) or expensive-and-wrong (without it). Deployments that
# accept Archi-authored models, which permit a part to have several wholes, will want it deactivated
# rather than fixed — the models are not wrong so much as written to a more permissive contract.
avcore:CompositionPartUniqueness rdf:type sh:NodeShape ;
    sh:targetObjectsOf archimate:composition ;
    rdfs:label "Composition Part Uniqueness" ;
    rdfs:comment "Enforces that each composed part belongs to exactly one whole (exclusive ownership). Exempts the case where one composer is a composition-ancestor of another (e.g. a company directly composing a sub-team that a department also directly composes) — that's a redundant re-assertion of an already-transitive relationship, not a genuine ownership conflict." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "A composed part can only belong to one whole (composition implies exclusive ownership)" ;
        sh:select """
            SELECT $this WHERE {
                {
                    SELECT $this WHERE {
                        ?whole archimate:composition $this .
                    }
                    GROUP BY $this
                    HAVING (COUNT(DISTINCT ?whole) > 1)
                }
                ?w1 archimate:composition $this .
                ?w2 archimate:composition $this .
                FILTER(?w1 != ?w2)
                FILTER NOT EXISTS { ?w1 archimate:composition+ ?w2 }
                FILTER NOT EXISTS { ?w2 archimate:composition+ ?w1 }
            }
        """
    ] .

## 3.2 Aggregation Relationships

# No self-aggregation
avcore:NoSelfAggregation rdf:type sh:NodeShape ;
    sh:targetClass archimate:Element ;
    rdfs:label "No Self-Aggregation" ;
    rdfs:comment "Prevents an element from aggregating itself." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Elements cannot aggregate themselves" ;
        sh:select """
            SELECT $this WHERE {
                $this archimate:aggregation $this
            }
        """
    ] .

# No circular aggregation
avcore:NoCircularAggregation rdf:type sh:NodeShape ;
    sh:targetClass archimate:Element ;
    rdfs:label "No Circular Aggregation" ;
    rdfs:comment "Prevents circular aggregation chains." ;
    sh:sparql [
        sh:prefixes <https://purl.org/archimate/validation> ;
        sh:message "Circular aggregation relationships are not allowed" ;
        sh:select """
            SELECT $this WHERE {
                $this archimate:aggregation+ $this
            }
        """
    ] .

